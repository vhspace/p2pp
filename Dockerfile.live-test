FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    xvfb \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libatspi2.0-0 \
    python3 \
    python3-pip \
    python3-venv \
    git \
    fuse \
    && rm -rf /var/lib/apt/lists/*

# Slicer versions are pinned in .slicer-versions.env
# PrusaSlicer 2.8.1 (latest with Linux AppImage)
ARG PRUSA_SLICER_URL="https://github.com/prusa3d/PrusaSlicer/releases/download/version_2.8.1/PrusaSlicer-2.8.1+linux-x64-newer-distros-GTK3-202409181416.AppImage"
RUN wget -q "$PRUSA_SLICER_URL" -O /usr/local/bin/prusa-slicer && \
    chmod +x /usr/local/bin/prusa-slicer

# OrcaSlicer 2.4.2
ARG ORCA_SLICER_URL="https://github.com/OrcaSlicer/OrcaSlicer/releases/download/v2.4.2/OrcaSlicer_Linux_AppImage_Ubuntu2404_V2.4.2.AppImage"
RUN wget -q "$ORCA_SLICER_URL" -O /usr/local/bin/orca-slicer && \
    chmod +x /usr/local/bin/orca-slicer

# Create workspace and install p2pp
WORKDIR /workspace
COPY . /workspace

RUN python3 -m pip install --upgrade pip && \
    pip install -r requirements-common.txt && \
    pip install -e .

# Create directories for models and profiles
RUN mkdir -p /workspace/tests/models /workspace/profiles

# Copy profiles
COPY profiles/ /workspace/profiles/

# Create entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["--help"]