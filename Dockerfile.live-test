FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    xvfb \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libatspi2.0-0 \
    python3 \
    python3-pip \
    python3-venv \
    git \
    fuse \
    && rm -rf /var/lib/apt/lists/*

# Download PrusaSlicer AppImage (latest stable)
ARG PRUSA_SLICER_VERSION=2.7.4
RUN wget -q "https://github.com/prusa3d/PrusaSlicer/releases/download/version_${PRUSA_SLICER_VERSION}/PrusaSlicer-${PRUSA_SLICER_VERSION}+linux64-202407280943-GTK3.AppImage" \
    -O /usr/local/bin/prusa-slicer && \
    chmod +x /usr/local/bin/prusa-slicer

# Create workspace and install p2pp
WORKDIR /workspace
COPY . /workspace

RUN python3 -m pip install --upgrade pip && \
    pip install -r requirements-common.txt && \
    pip install -e .

# Create directories for models and profiles
RUN mkdir -p /workspace/tests/models /workspace/profiles

# Download sample multi-color test models
RUN wget -q "https://github.com/prusa3d/PrusaSlicer-test-models/raw/main/3mf/Color_cube.3mf" \
    -O /workspace/tests/models/multi-color.3mf && \
    wget -q "https://github.com/prusa3d/PrusaSlicer-test-models/raw/main/stl/Color_cube.stl" \
    -O /workspace/tests/models/multi-color.stl

# Copy Palette 3 printer profile
COPY profiles/palette3.ini /workspace/profiles/palette3.ini

# Create entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["--help"]